DB_URL=jdbc:postgresql://localhost:5432/oncologia
DB_USUARIO=oncologia
DB_PASSWORD=oncologia

JWT_SECRET=cambia-este-secreto-en-produccion-minimo-32-caracteres
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7

CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_BASE_URL=http://localhost:4200

N8N_WEBHOOK_SECRET=cambia-este-secreto-de-webhook
N8N_BASE_URL=http://localhost:5678

# Chatbot con Gemini (seccion 13). Clave gratuita en https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Autoservicio de registro de pacientes (seccion 7): en false hasta tener el
# SMTP/n8n de verificacion de correo configurado.
REGISTRO_PACIENTES_HABILITADO=false

MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=oncologia-backend
MQTT_TOPIC=oncologia/dispositivos/+/lecturas

# Correo transaccional: verificacion al registrarse, restablecer contrasena y
# bienvenida al crear un usuario. Principal: API de correo (MAIL_FLAG_QUIPU);
# respaldo: SMTP (MAIL_FLAG_SMTP). Si ambos estan en true se intenta la API y
# luego SMTP. Con correo activo se puede poner REGISTRO_PACIENTES_HABILITADO=true.
MAIL_FLAG_QUIPU=false
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FLAG_SMTP=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Fundacion Oncologica Three Partners
# Logo de la cabecera del correo: URL PUBLICA. Vacio = <portal>/logo-correo.png
# (en local apunta a localhost y no se vera en una bandeja real).
MAIL_LOGO_URL=
FRONTEND_INTRANET_URL=http://localhost:4300
