{
  "name": "Oncologia - Recordatorio de Citas (WhatsApp)",
  "id": "c87cdb7b-d314-475b-8ec1-b5b10e73683d",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "6ab7ce7f-36a4-4233-bd4e-e0c911247924",
      "name": "Cron diario 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "938e6c38-bc7f-4f6d-b213-1c1970316194",
      "name": "Obtener token de servicio",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [260, 0],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "85b21806-8fc1-4c83-a80d-fe8ab9cd4e77",
          "mode": "list",
          "cachedResultName": "Oncologia - Obtener Token de Servicio"
        }
      }
    },
    {
      "id": "a2772427-9773-4bdb-b44b-d2caf5e68888",
      "name": "Obtener citas proximas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0],
      "notes": "Consume RF-06 / seccion 15 flujo 2: ventana de 24-48h antes de la cita.",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ONCOLOGIA_API_URL }}/citas/proximas",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "horasDesde", "value": "24" },
            { "name": "horasHasta", "value": "48" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.accessToken }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "fc69b76a-bfd9-4a4f-bfe5-aaaa6a83052e",
      "name": "Obtener datos del paciente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 0],
      "notes": "Se ejecuta una vez por cada cita (n8n separa el array de la respuesta anterior en items). Necesitamos el telefono del paciente, que Cita no trae.",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ONCOLOGIA_API_URL }}/pacientes/{{ $json.pacienteId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Obtener token de servicio').item.json.accessToken }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0a948adc-6974-47c6-ba14-9ca16de2b53b",
      "name": "Tiene telefono valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1040, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "e8169ca4-cf13-422e-bdf6-f96dec791c58",
              "leftValue": "={{ $json.telefono }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1d875d5-e2db-4efe-bf26-b90a70e1a633",
      "name": "Enviar recordatorio WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, -120],
      "continueOnFail": true,
      "notes": "Requiere una plantilla de mensaje 'recordatorio_cita' previamente aprobada en Meta Business Manager, con 3 variables de cuerpo: nombre, fecha, hora. Alternativa: reemplazar por un nodo/llamada equivalente a Twilio (seccion 4 del prompt admite ambas opciones).",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.telefono, type: 'template', template: { name: 'recordatorio_cita', language: { code: 'es' }, components: [ { type: 'body', parameters: [ { type: 'text', text: ($json.nombres + ' ' + $json.apellidos) }, { type: 'text', text: $('Obtener citas proximas').item.json.fecha }, { type: 'text', text: $('Obtener citas proximas').item.json.hora } ] } ] } }) }}",
        "options": {}
      }
    },
    {
      "id": "377f2a71-d4ca-4d93-83e5-74ba782f6c21",
      "name": "Envio exitoso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1560, -120],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "d84437aa-995a-4bc9-83b0-25dd8a22e6f2",
              "leftValue": "={{ $json.messages }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "22fdb034-910c-46cb-b209-497b93bdd83b",
      "name": "Registrar notificacion enviada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1820, -180],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ONCOLOGIA_API_URL }}/notificaciones/callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ citaId: $('Obtener citas proximas').item.json.id, canal: 'WHATSAPP', estadoEnvio: 'ENVIADO' }) }}",
        "options": {}
      }
    },
    {
      "id": "31dbbede-e0b2-49ab-9530-f86ef71bf392",
      "name": "Registrar notificacion fallida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 120],
      "notes": "Recibe tanto el caso 'sin telefono registrado' como el caso 'fallo el envio de WhatsApp'.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ONCOLOGIA_API_URL }}/notificaciones/callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ citaId: $('Obtener citas proximas').item.json.id, canal: 'WHATSAPP', estadoEnvio: 'FALLIDO' }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Cron diario 08:00": {
      "main": [[{ "node": "Obtener token de servicio", "type": "main", "index": 0 }]]
    },
    "Obtener token de servicio": {
      "main": [[{ "node": "Obtener citas proximas", "type": "main", "index": 0 }]]
    },
    "Obtener citas proximas": {
      "main": [[{ "node": "Obtener datos del paciente", "type": "main", "index": 0 }]]
    },
    "Obtener datos del paciente": {
      "main": [[{ "node": "Tiene telefono valido?", "type": "main", "index": 0 }]]
    },
    "Tiene telefono valido?": {
      "main": [
        [{ "node": "Enviar recordatorio WhatsApp", "type": "main", "index": 0 }],
        [{ "node": "Registrar notificacion fallida", "type": "main", "index": 0 }]
      ]
    },
    "Enviar recordatorio WhatsApp": {
      "main": [[{ "node": "Envio exitoso?", "type": "main", "index": 0 }]]
    },
    "Envio exitoso?": {
      "main": [
        [{ "node": "Registrar notificacion enviada", "type": "main", "index": 0 }],
        [{ "node": "Registrar notificacion fallida", "type": "main", "index": 0 }]
      ]
    }
  }
}
