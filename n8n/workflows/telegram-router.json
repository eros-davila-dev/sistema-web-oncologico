    {
      "id": "eda81b53-c0ee-5435-829d-9115ed14e761",
      "name": "Clasificar update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// Normaliza el update de Telegram y decide la ruta (indice de salida del Switch).\n// 0 vincular | 1 bienvenida | 2 /stop | 3 /persona | 4 boton de recordatorio | 5 valoracion | 6 texto libre\nconst salida = [];\nfor (const item of $input.all()) {\n  const u = item.json;\n  const callback = u.callback_query;\n  const mensaje = u.message;\n  if (callback) {\n    const [tipo, id, valor] = String(callback.data || '').split(':');\n    const base = {\n      chatId: callback.message?.chat?.id,\n      callbackQueryId: callback.id,\n      messageId: callback.message?.message_id,\n    };\n    if (tipo === 'r') salida.push({ json: { ...base, ruta: 4, recordatorioId: Number(id), accion: valor } });\n    else if (tipo === 'v') salida.push({ json: { ...base, ruta: 5, consultaId: Number(id), valor: Number(valor) } });\n    continue;\n  }\n  if (!mensaje || typeof mensaje.text !== 'string') continue; // fotos, stickers, etc.: se ignoran\n  const texto = mensaje.text.trim();\n  const chatId = mensaje.chat.id;\n  if (texto.startsWith('/start ')) salida.push({ json: { ruta: 0, chatId, token: texto.substring(7).trim() } });\n  else if (texto === '/start' || texto === '/ayuda') salida.push({ json: { ruta: 1, chatId } });\n  else if (texto === '/stop') salida.push({ json: { ruta: 2, chatId } });\n  else if (texto === '/persona') salida.push({ json: { ruta: 3, chatId } });\n  else salida.push({ json: { ruta: 6, chatId, texto } });\n}\nreturn salida;"
      }
    },
    {
      "id": "f0041404-f947-5d12-8ce9-c1dabb976c9b",
