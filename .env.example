JWT_SECRET=cambia-este-secreto-en-produccion-minimo-32-caracteres
# Portal del paciente (4200) e intranet del personal (4300)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
# URL publica del PORTAL DEL PACIENTE, usada para construir los enlaces de verificacion
# de correo y restablecimiento de contrasena del portal de autoservicio de
# pacientes (seccion 7).
FRONTEND_BASE_URL=http://localhost:4200

# Chatbot con Gemini (seccion 13). Clave gratuita en https://aistudio.google.com/apikey.
# Sin esta clave el chatbot sigue funcionando pero responde en modo degradado
# ("no puedo procesar tu mensaje ahora"), nunca falla la peticion.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Autoservicio de registro de pacientes (seccion 7): en false hasta tener
# configurado el envio real de correo de verificacion (SMTP/n8n). Ponerlo en
# true una vez ese workflow este listo; mientras tanto el backend rechaza
# cualquier intento de registro con un mensaje claro, sin crear cuentas
# huerfanas que nunca podrian verificarse.
REGISTRO_PACIENTES_HABILITADO=false
N8N_WEBHOOK_SECRET=cambia-este-secreto-de-webhook
# Clave con la que n8n cifra las credenciales guardadas (token del bot, etc.).
# Debe ser estable: si cambia, las credenciales ya guardadas dejan de servir.
N8N_ENCRYPTION_KEY=cambia-esta-clave-de-cifrado-de-n8n
# URL publica HTTPS de n8n (tunel cloudflared/ngrok en desarrollo). Telegram
# solo entrega updates a webhooks HTTPS.
N8N_WEBHOOK_URL=http://localhost:5678/
# regular (piloto) | queue (requiere --profile escalado para el worker)
N8N_EXECUTIONS_MODE=regular

# Telegram (recordatorios y chatbot). El TOKEN del bot NO va aqui: se guarda
# como credencial dentro de n8n. Aqui solo el usuario publico del bot (para
# armar el enlace t.me/<bot>?start=<token>) y los grupos de alertas.
TELEGRAM_BOT_USERNAME=
TELEGRAM_GRUPO_PERSONAL_CHAT_ID=
TELEGRAM_GRUPO_TECNICO_CHAT_ID=

POSTGRES_PASSWORD=oncologia
