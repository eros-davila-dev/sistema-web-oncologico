JWT_SECRET=cambia-este-secreto-en-produccion-minimo-32-caracteres
CORS_ALLOWED_ORIGINS=http://localhost:4200
# URL publica del frontend, usada para construir los enlaces de verificacion
# de correo y restablecimiento de contrasena del portal de autoservicio de
# pacientes (seccion 7).
FRONTEND_BASE_URL=http://localhost:4200

# Chatbot con Gemini (seccion 13). Clave gratuita en https://aistudio.google.com/apikey.
# Sin esta clave el chatbot sigue funcionando pero responde en modo degradado
# ("no puedo procesar tu mensaje ahora"), nunca falla la peticion.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Autoservicio de registro de pacientes (seccion 7): en false hasta tener
# configurado el envio real de correo de verificacion (SMTP/n8n). Ponerlo en
# true una vez ese workflow este listo; mientras tanto el backend rechaza
# cualquier intento de registro con un mensaje claro, sin crear cuentas
# huerfanas que nunca podrian verificarse.
REGISTRO_PACIENTES_HABILITADO=false
N8N_WEBHOOK_SECRET=cambia-este-secreto-de-webhook
N8N_USER=admin
N8N_PASSWORD=cambia-esta-clave

# Cuenta de servicio que usan los workflows de n8n para llamar a la API (ver n8n/README.md).
# Se crea una vez el sistema esta arriba, desde Usuarios y roles (rol RECEPCIONISTA).
ONCOLOGIA_SERVICE_EMAIL=n8n@threepartners.org
ONCOLOGIA_SERVICE_PASSWORD=cambia-esta-clave

# WhatsApp Business Cloud API (Meta) - flujo de recordatorios (n8n/workflows/recordatorio-citas-whatsapp.json)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
