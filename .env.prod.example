# Variables de PRODUCCION (docker-compose.prod.yml). Copiar como .env en el
# servidor y completar. Nunca se commitea el .env real.
#
# Generar secretos aleatorios, por ejemplo:  openssl rand -base64 48

# --- Dominios (deben apuntar por DNS a este servidor) -----------------------
DOMINIO_PORTAL=portal.fundacion.pe
DOMINIO_INTRANET=intranet.fundacion.pe
DOMINIO_N8N=n8n.fundacion.pe
# Correo para Let's Encrypt (avisos de vencimiento de certificados)
ACME_EMAIL=sistemas@fundacion.pe

# Redes desde las que se permite la intranet y el editor de n8n (CIDR
# separados por espacio). private_ranges = solo redes privadas.
# Ejemplo con la IP publica de la sede:  INTRANET_IPS_PERMITIDAS=200.48.10.25/32 private_ranges
INTRANET_IPS_PERMITIDAS=private_ranges
N8N_IPS_EDITOR=private_ranges

# --- Secretos (obligatorios) -------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
N8N_WEBHOOK_SECRET=
# Estable: si cambia, n8n ya no puede leer las credenciales guardadas (token del bot)
N8N_ENCRYPTION_KEY=

# Contrasena que reemplaza a la de la semilla (Admin123!) en el primer
# arranque. Minimo 12 caracteres. Despues del primer arranque puede borrarse.
ADMIN_PASSWORD_INICIAL=

# --- Integraciones -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TELEGRAM_BOT_USERNAME=
TELEGRAM_GRUPO_PERSONAL_CHAT_ID=
TELEGRAM_GRUPO_TECNICO_CHAT_ID=
N8N_EXECUTIONS_MODE=regular

# En true solo cuando exista el workflow de correo de verificacion (n8n/README.md)
REGISTRO_PACIENTES_HABILITADO=false
